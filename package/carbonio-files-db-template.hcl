// Generated by carbonio-files-db-hcl from the packaged template on every
// upgrade and setup: local edits to this file are overwritten.
// To change the values, set them in /etc/zextras/service-discover/carbonio-files-db.env
// (KEY=value lines; "carbonio-files-db-hcl show" lists keys and defaults),
// then run carbonio-files-db setup.

services {
  check {
    tcp      = "{{ or (env "DB_ADDRESS") "127.0.0.1" }}:5432"
    timeout  = "{{ or (env "CHECK_TIMEOUT") "1s" }}"
    interval = "{{ or (env "CHECK_INTERVAL") "5s" }}"
  }
  connect {
    sidecar_service {
      proxy {
        local_service_address = "{{ or (env "DB_ADDRESS") "127.0.0.1" }}"
      }
    }
  }
  name    = "carbonio-files-db"
  port    = 5432
}
