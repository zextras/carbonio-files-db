if [[ $(id -u) -ne 0 ]]; then
  echo "Please run as root"
  exit 1
fi

if [[ "$1" != "setup" ]]; then
  echo "Syntax: carbonio-files-db <setup> to automatically setup the service"
  exit 1;
fi

if [ -f /etc/zextras/service-discover/templates/carbonio-files-db-template.hcl ]; then
  # shellcheck disable=SC2016
  if ! env -i PATH=/usr/bin:/bin bash -c 'set -a; [ -r "$1" ] && . "$1"; exec consul-template -once -template "$2:$3"' _ \
    /etc/zextras/service-discover/carbonio-files-db.env \
    /etc/zextras/service-discover/templates/carbonio-files-db-template.hcl \
    /etc/zextras/service-discover/carbonio-files-db.hcl > /dev/null; then
    echo "Cannot render /etc/zextras/service-discover/carbonio-files-db.hcl; leaving pending-setup to be retried."
    exit 1
  fi
fi

# Decrypt the bootstrap token, asking the password to the sys admin
# --setup check for SETUP_CONSUL_TOKEN env. variable and uses it
# to avoid re-asking for the password multiple times
echo -n "Insert the cluster credential password: "
export CONSUL_HTTP_TOKEN
CONSUL_HTTP_TOKEN=$(service-discover bootstrap-token --setup)
EXIT_CODE="$?"
echo ""
if [[ "${EXIT_CODE}" != "0" ]]; then
  echo "cannot access to bootstrap token"
  exit 1;
fi
# Limit secret visibility as much as possible
export -n SETUP_CONSUL_TOKEN

POLICY_NAME='carbonio-files-db-policy'
POLICY_DESCRIPTION='Carbonio Files database service policy for config generation and for sidecar proxy'

# Create or update policy for the specific service (this will be shared across cluster)
if ! consul acl policy create -name "${POLICY_NAME}" -description "${POLICY_DESCRIPTION}" -rules @/etc/carbonio/files-db/service-discover/policies.json >/dev/null 2>&1; then
    if ! consul acl policy update -no-merge -name "${POLICY_NAME}" -description "${POLICY_DESCRIPTION}" -rules @/etc/carbonio/files-db/service-discover/policies.json; then
      echo "Setup failed: Cannot update policy for ${POLICY_NAME}"
      exit 1
    fi
fi

# Declare the service as tcp
consul config write /etc/carbonio/files-db/service-discover/service-protocol.json

# Allow other services to contact this service
consul config write /etc/carbonio/files-db/service-discover/intentions.json

service-discover service-token ensure --service carbonio-files-db --policy "${POLICY_NAME}" \
  --token-file /etc/carbonio/files-db/service-discover/token --owner carbonio-files-db || {
  echo "Setup failed: cannot ensure service token"
  exit 1
}

consul reload

systemctl restart carbonio-files-db-sidecar.service

service-discover service-token prune-legacy --service carbonio-files-db --policy "${POLICY_NAME}"

# Limit token visibility as much as possible
export -n CONSUL_HTTP_TOKEN
rc=$?
cat << 'EOF'

Sidecar Config (overridable by /etc/zextras/service-discover/carbonio-files-db.env, apply with carbonio-files-db setup)

┌────────────────┬───────────┐
│ Key            │ Default   │
├────────────────┼───────────┤
│ DB_ADDRESS     │ 127.0.0.1 │
│ CHECK_TIMEOUT  │ 1s        │
│ CHECK_INTERVAL │ 5s        │
└────────────────┴───────────┘

EOF
exit "${rc}"
