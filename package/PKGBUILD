backup=(
  "etc/zextras/service-discover/carbonio-files-db.hcl"
)

_package_common() {
  install -Dm644 "${srcdir}/111-carbonio-files-db-setup.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/111-carbonio-files-db-setup.sh"
  install -Dm755 "${srcdir}/carbonio-files-db" \
    "${pkgdir}/usr/bin/carbonio-files-db"
  install -Dm644 "${srcdir}/carbonio-files-db.hcl" \
    "${pkgdir}/etc/zextras/service-discover/carbonio-files-db.hcl"
  install -Dm755 "${srcdir}/carbonio-files-db-bootstrap" \
    "${pkgdir}/usr/bin/carbonio-files-db-bootstrap"
  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/files-db/service-discover/intentions.json"
  install -Dm644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/files-db/service-discover/policies.json"
  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/files-db/service-discover/service-protocol.json"
}

_package_systemd() {
  _package_common
  install -Dm644 "${srcdir}/carbonio-files-db-sidecar.service" \
    "${pkgdir}/lib/systemd/system/carbonio-files-db-sidecar.service"
}

_package_legacy() {
  _package_common
  install -Dm644 "${srcdir}/carbonio-files-db-sidecar-legacy.service" \
    "${pkgdir}/lib/systemd/system/carbonio-files-db-sidecar.service"
}

package() { _package_systemd; }
package__rocky_8() { _package_legacy; }
package__ubuntu_jammy() { _package_legacy; }

postinst() {
  getent group 'carbonio-files-db' >/dev/null ||
    groupadd -r 'carbonio-files-db'
  getent passwd 'carbonio-files-db' >/dev/null ||
    useradd -r -M -g 'carbonio-files-db' -s /sbin/nologin 'carbonio-files-db'

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-files-db-sidecar.service >/dev/null 2>&1 || :
  fi

  echo "======================================================"
  echo "Carbonio Files DB installed successfully!"
  echo "You must run pending-setups to configure it correctly."
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl disable --now carbonio-files-db-sidecar.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  rm -Rf /etc/carbonio/files-db/
  rm -f /etc/zextras/pending-setups.d/111-carbonio-files-db-setup.sh
  rm -f /etc/zextras/pending-setups.d/done/111-carbonio-files-db-setup.sh

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
