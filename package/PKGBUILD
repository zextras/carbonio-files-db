pkgver="0.3.0"
pkgrel="SNAPSHOT"
pkgdesc="Carbonio Files DB sidecar"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('any')
license=("AGPL-3.0-only")
depends__apt=(
  "service-discover"
  "service-discover-base"
  "pending-setups"
  "carbonio-core"
  "postgresql-client"
)

depends__yum=(
  "service-discover"
  "service-discover-base"
  "pending-setups"
  "carbonio-core"
  "postgresql"
)

source=(
  "111-carbonio-files-db-setup.sh"
  "carbonio-files-db"
  "carbonio-files-db.hcl"
  "carbonio-files-db-bootstrap"
  "carbonio-files-db-sidecar.service"
  "carbonio-files-db-sidecar-legacy.service"
  "intentions.json"
  "policies.json"
  "service-protocol.json"
)

