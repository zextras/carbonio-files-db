[Unit]
Description=Carbonio Files DB Sidecar
Documentation=https://docs.zextras.com/
Requires=network-online.target
After=network-online.target service-discover.service
PartOf=service-discover.target

# The token is written by the pending setup ("carbonio-files-db setup") once
# Consul is bootstrapped. Without it the sidecar cannot start: skip it
# instead of failing every 15 s and holding up units ordered after it.
ConditionPathExists=/etc/carbonio/files-db/service-discover/token

[Service]
User=carbonio-files-db
Type=notify
NotifyAccess=all
TimeoutStartSec=120
Environment=ENVOY_READY_TIMEOUT=90
ExecStart=/usr/bin/service-discover-wrapper.sh \
    -token-file /etc/carbonio/files-db/service-discover/token \
    -admin-bind localhost:0 \
    -sidecar-for carbonio-files-db
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=15s
KillSignal=SIGINT
LimitNOFILE=65536

# Hardening
PrivateTmp=yes
#ProtectSystem=strict
ProtectSystem=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=service-discover.target
